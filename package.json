{
  "name": "foody",
  "version": "0.1.0",
  "private": true,
  "description": "Foody — a Slack-native group food-ordering agent. Type \"let's eat something\" and the team builds one shared basket from emoji reactions.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Tim Dries",
  "homepage": "https://github.com/tdries/Foody-Slack-Hackathon-Submission#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdries/Foody-Slack-Hackathon-Submission.git"
  },
  "bugs": {
    "url": "https://github.com/tdries/Foody-Slack-Hackathon-Submission/issues"
  },
  "keywords": [
    "slack",
    "slack-bot",
    "slack-agent",
    "socket-mode",
    "block-kit",
    "food-delivery",
    "group-ordering",
    "typescript",
    "hackathon"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:slack": "tsx watch src/slack/app.ts",
    "start": "tsx src/slack/app.ts",
    "start:demo": "FOODY_DISABLE_LIVE=1 tsx src/slack/app.ts",
    "foody": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@slack/bolt": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "puppeteer": "^25.0.4",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
