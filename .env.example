# Foody configuration

# Slack (Socket Mode for local dev — no public URL needed)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Foody runtime
FOODY_LOG_LEVEL=info

# Restrict the bot to specific Slack channel IDs (comma-separated). Empty = all.
FOODY_CHANNELS=

# --- Optional: only needed once, to bulk-upload dish-image custom emojis ---
# See scripts/upload-emojis.mjs for the extraction recipe. These authenticate
# the *user* (you) — they don't grant the bot anything extra.

# Workspace subdomain (the part before .slack.com in your URL).
FOODY_SLACK_TEAM_DOMAIN=

# xoxc- token, from your browser's Slack session.
FOODY_SLACK_XOXC=

# Value of the `d` cookie for slack.com, from your browser.
FOODY_SLACK_D_COOKIE=
