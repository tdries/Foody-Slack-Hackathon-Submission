# Foody configuration

# Slack (Socket Mode for local dev — no public URL needed)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# AI assistant pane (Slack AI apps) — powers the natural-language ordering flow
ANTHROPIC_API_KEY=sk-ant-...

# Foody runtime
FOODY_LOG_LEVEL=info

# Demo / hosted mode: 1 = use bundled mock data only (no live scraping, no Chrome).
# Makes the whole Slack flow deterministic and server-safe — set this on any host.
FOODY_DISABLE_LIVE=

# Which takeaway.com market to scrape + order on. Default be-en (Belgium).
# Any takeaway.com locale that shares the same site DOM works (e.g. nl).
# Other Just Eat brands / providers (Lieferando, Just Eat, Uber Eats) need their
# own adapter — see src/scrape-live.ts.
FOODY_TAKEAWAY_LOCALE=be-en

# Restrict the bot to specific Slack channel IDs (comma-separated). Empty = all.
FOODY_CHANNELS=

# --- Optional: only needed once, to bulk-upload dish-image custom emojis ---
# See scripts/upload-emojis.mjs for the extraction recipe. These authenticate
# the *user* (you) — they don't grant the bot anything extra.

# Workspace subdomain (the part before .slack.com in your URL).
FOODY_SLACK_TEAM_DOMAIN=

# xoxc- token, from your browser's Slack session.
FOODY_SLACK_XOXC=

# Value of the `d` cookie for slack.com, from your browser.
FOODY_SLACK_D_COOKIE=
